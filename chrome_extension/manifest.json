{
  "manifest_version": 3,
  "name": "TapApply Companion",
  "version": "0.1.0",
  "description": "Launch TapApply UK job workflows directly from Chrome.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "TapApply Companion"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"]
}
